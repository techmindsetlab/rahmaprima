---
import { getLocale, t } from "@/i18n";
import { parseGuestParams } from "@/lib/guest";
const locale = getLocale(Astro.url);
const { moment } = parseGuestParams(Astro.url);
const showAkad = moment === "akad" || moment === "both";
const showResepsi = moment === "resepsi" || moment === "both";
---

<section id="date" class="relative bg-burgundy-deep text-cream py-28 md:py-40 overflow-hidden">
  <div class="absolute inset-0 opacity-40 pointer-events-none"
       style="background: radial-gradient(60% 50% at 50% 30%, #6B1E2A 0%, transparent 70%);"></div>

  <div class="relative container-fluid text-center">
    <p class="eyebrow text-cream/60 mb-10" data-reveal>{t(locale, "date.eyebrow")}</p>

    <p class="font-serif italic text-2xl md:text-3xl text-cream/80" data-reveal data-reveal-delay="0.1">
      {t(locale, "date.dayName")}
    </p>

    <div class="flex items-baseline justify-center gap-4 md:gap-8 my-4">
      <span class="rule w-16 md:w-24"></span>
      <span class="display-italic text-[26vw] md:text-[16vw] leading-none text-cream" data-reveal>
        {t(locale, "date.day")}
      </span>
      <span class="rule w-16 md:w-24"></span>
    </div>

    <p class="font-serif italic text-2xl md:text-3xl text-cream/80" data-reveal data-reveal-delay="0.2">
      {t(locale, "date.month")} · {t(locale, "date.year")}
    </p>

    <div class:list={[
      "mt-16 md:mt-24 grid gap-10 md:gap-16 max-w-3xl mx-auto",
      showAkad && showResepsi ? "md:grid-cols-2" : "md:grid-cols-1 place-items-center",
    ]}>
      {showAkad && (
        <div data-reveal>
          <p class="eyebrow text-burgundy-rose">{t(locale, "date.akad.label")}</p>
          <p class="font-serif text-2xl md:text-3xl mt-2 text-cream">{t(locale, "date.akad.time")}</p>
        </div>
      )}
      {showResepsi && (
        <div data-reveal data-reveal-delay="0.15">
          <p class="eyebrow text-burgundy-rose">{t(locale, "date.reception.label")}</p>
          <p class="font-serif text-2xl md:text-3xl mt-2 text-cream">{t(locale, "date.reception.time")}</p>
        </div>
      )}
    </div>
  </div>
</section>
