---
import { getLocale, t } from "@/i18n";
const locale = getLocale(Astro.url);
const mapQuery = encodeURIComponent("Aminta Hall Jl. Tol TB Simatupang Kav. 10, Pondok Pinang, Kebayoran Lama, Jakarta Selatan");
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section id="venue" class="relative isolate text-cream min-h-[100dvh] flex items-center overflow-hidden bg-ink">
  <!-- Full-bleed venue photo -->
  <img
    src="/photos/plaza-aminta.webp"
    alt="Aminta Hall — Plaza Aminta"
    class="absolute inset-0 w-full h-full object-cover z-0"
    loading="lazy"
  />
  <div class="absolute inset-0 z-[1] bg-gradient-to-t from-ink via-ink/60 to-ink/40"></div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-ink/50 via-transparent to-ink/85"></div>

  <div class="relative z-10 w-full container-fluid py-28 md:py-40">
    <div class="max-w-3xl mx-auto text-center">
      <p class="eyebrow text-cream/70" data-reveal>{t(locale, "venue.eyebrow")}</p>
      <h2 class="display-italic text-5xl md:text-7xl mt-4 mb-8 text-cream" data-reveal data-reveal-delay="0.1">
        {t(locale, "venue.name")}
      </h2>
      <p class="font-serif text-lg md:text-xl leading-relaxed text-cream/85 max-w-xl mx-auto" data-reveal data-reveal-delay="0.2">
        {t(locale, "venue.address")}
      </p>

      <a href={mapUrl} target="_blank" rel="noopener"
         class="btn-outline mt-10 backdrop-blur-sm bg-ink/30"
         data-reveal data-reveal-delay="0.3">
        <span class="btn-label">
          <span>{t(locale, "venue.cta")}</span>
          <span aria-hidden="true">{t(locale, "venue.cta")}</span>
        </span>
        <span class="btn-arrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 17L17 7M17 7H8M17 7V16"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
