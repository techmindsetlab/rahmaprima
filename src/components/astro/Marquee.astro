---
const { text = "Rahma & Prima" } = Astro.props;
const items = Array.from({ length: 8 }, (_, i) => i);
---

<div class="relative bg-burgundy text-cream py-6 md:py-8 overflow-hidden">
  <div class="flex whitespace-nowrap animate-marquee gap-10">
    {items.map(() => (
      <span class="display-italic text-3xl md:text-5xl flex items-center gap-8">
        {text}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="opacity-70">
          <path d="M12 2l2 8 8 2-8 2-2 8-2-8-8-2 8-2z"/>
        </svg>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .animate-marquee { animation: marquee 30s linear infinite; width: max-content; }
</style>
