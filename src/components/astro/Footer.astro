---
import { getLocale, t } from "@/i18n";
const locale = getLocale(Astro.url);
const bgImages = ["/photos/photo-13.jpg", "/photos/photo-14.jpg"];
---

<footer class="relative isolate bg-ink text-cream py-24 md:py-36 overflow-hidden min-h-[90dvh] flex items-center">
  <!-- Auto slideshow background (blur smooth fade) -->
  <div id="footer-bg" class="absolute inset-0 z-0">
    {bgImages.map((src, i) => (
      <img
        src={src}
        alt=""
        aria-hidden="true"
        class:list={["footer-bg-slide", i === 0 && "is-active"]}
        loading={i === 0 ? "eager" : "lazy"}
      />
    ))}
  </div>

  <!-- Dark overlay for text legibility -->
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-ink/85 via-ink/70 to-ink"></div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
  <div class="absolute inset-x-0 top-0 h-px z-[2] bg-cream/10"></div>

  <div class="relative z-10 container-fluid max-w-2xl mx-auto text-center w-full">
    <img src="/logo/monogram-white.png" alt="Rahma & Prima" class="mx-auto h-24 md:h-32 opacity-95 mb-8" data-reveal />
    <p class="font-serif italic text-lg md:text-xl text-cream/85 leading-relaxed" data-reveal data-reveal-delay="0.1">
      {t(locale, "footer.thanks")}
    </p>
    <p
      lang="ar"
      dir="rtl"
      class="font-naskh text-cream text-xl md:text-2xl mt-12"
      data-reveal data-reveal-delay="0.15"
    >
      {t(locale, "footer.closingArabic")}
    </p>
    <p class="eyebrow mt-3 text-burgundy-rose">{t(locale, "footer.closing")}</p>
    <p class="font-serif italic text-xl mt-6 text-cream" data-reveal data-reveal-delay="0.2">
      {t(locale, "footer.signature")}
    </p>
    <p class="display-italic text-4xl md:text-5xl mt-4 text-cream" data-reveal data-reveal-delay="0.3">
      Rahma &amp; Prima
    </p>

    <p class="mt-16 text-cream/40 text-xs">
      © 2026 · Made with love
    </p>
  </div>
</footer>

<style>
  .footer-bg-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: blur(6px);
    transform: scale(1.08);
    transition:
      opacity 2200ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 2200ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 6000ms linear;
    will-change: opacity, filter, transform;
  }
  .footer-bg-slide.is-active {
    opacity: 0.55;
    filter: blur(3px);
    transform: scale(1);
  }
  .footer-bg-slide.is-leaving {
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-bg-slide { transition: opacity 500ms ease; transform: none; filter: blur(3px); }
    .footer-bg-slide.is-active { opacity: 0.55; }
    .footer-bg-slide.is-leaving { opacity: 0; }
  }
</style>

<script>
  const bg = document.getElementById("footer-bg");
  if (bg) {
    const slides = Array.from(bg.querySelectorAll<HTMLImageElement>(".footer-bg-slide"));
    const prefersReduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (slides.length >= 2) {
      let idx = 0;
      let timer: number | undefined;

      function step() {
        const cur = slides[idx];
        idx = (idx + 1) % slides.length;
        const next = slides[idx];

        cur.classList.remove("is-active");
        cur.classList.add("is-leaving");
        next.classList.remove("is-leaving");
        next.classList.add("is-active");

        window.setTimeout(() => cur.classList.remove("is-leaving"), 2500);
      }

      const footer = bg.closest("footer");
      if (footer) {
        let running = false;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting && !running && !prefersReduce) {
              running = true;
              timer = window.setInterval(step, 5500);
            } else if (!e.isIntersecting && running) {
              running = false;
              if (timer) window.clearInterval(timer);
            }
          }
        }, { threshold: 0.1 });
        io.observe(footer);
      }
    }
  }
</script>
