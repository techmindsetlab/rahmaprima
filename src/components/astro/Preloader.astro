---
// Bloop preloader — burgundy satin curtain with SVG path morph.
// Runs once per session (sessionStorage flag), then bloops away.
---

<div id="preloader" aria-hidden="true">
  <svg
    id="preloader-svg"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Satin gradient — burgundy folds -->
      <linearGradient id="satin" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4A0E19" />
        <stop offset="30%" stop-color="#8B2E3A" />
        <stop offset="55%" stop-color="#6B1E2A" />
        <stop offset="80%" stop-color="#4A0E19" />
        <stop offset="100%" stop-color="#2A0810" />
      </linearGradient>
      <radialGradient id="sheen" cx="30%" cy="20%" r="60%">
        <stop offset="0%" stop-color="rgba(255,220,200,0.35)" />
        <stop offset="50%" stop-color="rgba(184,84,80,0.10)" />
        <stop offset="100%" stop-color="rgba(0,0,0,0)" />
      </radialGradient>
    </defs>

    <!-- Curtain path: full screen at start; bloops away by animating the bottom edge upward with a droop -->
    <path id="curtain" d="M0,0 L1000,0 L1000,1000 Q500,1000 0,1000 Z" fill="url(#satin)" />
    <path id="curtain-sheen" d="M0,0 L1000,0 L1000,1000 Q500,1000 0,1000 Z" fill="url(#sheen)" />
  </svg>

  <div id="preloader-inner">
    <img
      id="preloader-logo"
      src="/logo/monogram-white.png"
      alt="Rahma & Prima"
      width="220"
      height="195"
    />
    <div id="preloader-line"></div>
    <p id="preloader-caption">The Wedding of Rahma &amp; Prima</p>
  </div>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    will-change: transform;
  }
  #preloader-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  #preloader-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #F5EFE6;
    gap: 24px;
  }
  #preloader-logo {
    width: clamp(140px, 30vw, 220px);
    height: auto;
    opacity: 0;
    transform: scale(0.92);
    filter: drop-shadow(0 8px 40px rgba(0, 0, 0, 0.35));
  }
  #preloader-line {
    width: 0;
    height: 1px;
    background: rgba(245, 239, 230, 0.6);
  }
  #preloader-caption {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    opacity: 0;
    color: rgba(245, 239, 230, 0.85);
    margin: 0;
  }

  /* Prevent body scroll during preload */
  html.preloading, html.preloading body {
    overflow: clip;
  }

  @media (prefers-reduced-motion: reduce) {
    #preloader { display: none; }
  }
</style>

<script>
  import { gsap } from "gsap";

  const KEY = "rp-preloader-shown";
  const preloader = document.getElementById("preloader");
  const curtain = document.getElementById("curtain") as SVGPathElement | null;
  const sheen = document.getElementById("curtain-sheen") as SVGPathElement | null;
  const logo = document.getElementById("preloader-logo");
  const line = document.getElementById("preloader-line");
  const caption = document.getElementById("preloader-caption");

  const prefersReduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Skip on repeat visits within same session
  const alreadyShown = sessionStorage.getItem(KEY) === "1";

  if (!preloader || !curtain || !sheen || prefersReduce || alreadyShown) {
    preloader?.remove();
    document.documentElement.classList.remove("preloading");
  } else {
    document.documentElement.classList.add("preloading");

    // Path shapes:
    //  - full:   full-screen rect with slight droop at bottom
    //  - droop:  bottom edge sags deeply (bloop mid-out)
    //  - out:    entire panel pulled off top; bottom edge above viewport
    const full  = "M0,0 L1000,0 L1000,1000 Q500,1000 0,1000 Z";
    const droop = "M0,0 L1000,0 L1000,700  Q500,1150 0,700  Z";
    const out   = "M0,0 L1000,0 L1000,-50   Q500,300  0,-50   Z";

    curtain.setAttribute("d", full);
    sheen.setAttribute("d", full);

    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem(KEY, "1");
        preloader.remove();
        document.documentElement.classList.remove("preloading");
        // trigger any post-load hero animations
        document.dispatchEvent(new CustomEvent("preloader:done"));
      },
    });

    tl.to(logo, { opacity: 1, scale: 1, duration: 1.0, ease: "expo.out" }, 0.1)
      .to(line, { width: 80, duration: 0.9, ease: "expo.out" }, 0.3)
      .to(caption, { opacity: 1, duration: 0.8, ease: "power2.out" }, 0.5)
      .to({}, { duration: 0.6 }) // hold
      .to([logo, line, caption], {
        opacity: 0,
        y: -20,
        duration: 0.6,
        ease: "power3.in",
        stagger: 0.04,
      }, ">-0.1")
      .to([curtain, sheen], {
        attr: { d: droop },
        duration: 0.55,
        ease: "power2.in",
      }, ">-0.35")
      .to([curtain, sheen], {
        attr: { d: out },
        duration: 0.9,
        ease: "expo.inOut",
      }, ">-0.05");
  }
</script>
