---
import { getLocale, t } from "@/i18n";

const locale = getLocale(Astro.url);
// Static build: render default. Real guest name is injected client-side
// from ?to= URL param (see script at bottom).
const displayName = t(locale, "opener.guestDefault");
const welcomeLines = t(locale, "opener.welcome").split("\n");
---

<div id="opener" aria-hidden="false" data-state="idle">
  <div id="opener-bg"></div>
  <div id="opener-vignette"></div>

  <!-- Burgundy satin exit curtain -->
  <svg id="opener-curtain" viewBox="0 0 1000 1000" preserveAspectRatio="none">
    <defs>
      <linearGradient id="op-satin" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4A0E19" />
        <stop offset="40%" stop-color="#8B2E3A" />
        <stop offset="70%" stop-color="#6B1E2A" />
        <stop offset="100%" stop-color="#2A0810" />
      </linearGradient>
    </defs>
    <path id="op-path" d="M0,1100 Q500,1100 1000,1100 L1000,1100 L0,1100 Z" fill="url(#op-satin)" />
  </svg>

  <div id="opener-inner">
    <!-- TOP: Title -->
    <div id="opener-top">
      <h1 id="opener-title">RAHMA <span class="accent-italic text-cream/95">&amp;</span> PRIMA</h1>
    </div>

    <!-- MIDDLE: spacer for photo to breathe -->
    <div id="opener-mid" aria-hidden="true"></div>

    <!-- BOTTOM: welcome + guest name + button -->
    <div id="opener-bottom">
      <p id="opener-welcome">
        {welcomeLines.map((line, i) => (
          <>
            {line}{i < welcomeLines.length - 1 && <br />}
          </>
        ))}
      </p>
      <p id="opener-dear" class="eyebrow text-cream/60">{t(locale, "opener.dear")}</p>
      <p id="opener-guest">{displayName}</p>

      <button id="opener-btn" type="button" data-anim="idle">
        <span class="opener-btn-fill" aria-hidden="true"></span>
        <span class="opener-btn-label">{t(locale, "opener.button")}</span>
      </button>

      <!-- Countdown ring (hidden until click) -->
      <div id="opener-countdown" aria-hidden="true">
        <div class="opener-ring-wrap">
          <svg class="opener-ring" viewBox="0 0 120 120">
            <defs>
              <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0A0A0A" />
                <stop offset="50%" stop-color="#4A0E19" />
                <stop offset="100%" stop-color="#B85450" />
              </linearGradient>
            </defs>
            <circle class="opener-ring-track" cx="60" cy="60" r="54" />
            <circle id="opener-ring-progress" cx="60" cy="60" r="54" />
          </svg>
          <span id="opener-num">10</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #opener {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    color: #F5EFE6;
  }
  #opener-bg {
    position: absolute; inset: 0;
    background-image: url("/photos/opener-bg.webp");
    background-size: cover;
    background-position: center;
    background-color: #0A0A0A;
    transform: scale(1.06);
    animation: op-zoom 16s ease-out forwards;
  }
  @keyframes op-zoom { to { transform: scale(1); } }

  #opener-vignette {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom,
        rgba(0,0,0,0.85) 0%,
        rgba(0,0,0,0.35) 18%,
        transparent 40%,
        transparent 55%,
        rgba(0,0,0,0.6) 85%,
        rgba(0,0,0,0.9) 100%);
  }
  #opener-curtain {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    display: block;
    z-index: 3;
  }

  #opener-inner {
    position: relative;
    z-index: 2;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(28px, 5vh, 60px) var(--page-pad) clamp(36px, 7vh, 80px);
    text-align: center;
  }

  #opener-top { display: flex; justify-content: center; align-items: flex-start; }
  #opener-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.8rem, 8vw, 3.5rem);
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0;
    color: #F5EFE6;
    opacity: 0;
    text-shadow: 0 2px 24px rgba(0,0,0,0.6);
    animation: op-in 1.1s 0.3s ease-out forwards;
  }
  #opener-title .accent-italic { color: rgba(245,239,230,0.95); }

  #opener-bottom {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    max-width: 500px; margin: 0 auto; width: 100%;
  }
  #opener-welcome {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(245,239,230,0.85);
    line-height: 1.9;
    margin: 0 0 8px;
    opacity: 0;
    animation: op-in 1s 0.7s ease-out forwards;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }
  #opener-dear {
    margin: 0;
    opacity: 0;
    animation: op-in 0.9s 0.9s ease-out forwards;
  }
  #opener-guest {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 5vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: #F5EFE6;
    margin: 4px 0 20px;
    opacity: 0;
    animation: op-in 1.1s 1.1s ease-out forwards;
    text-shadow: 0 2px 20px rgba(0,0,0,0.55);
    text-wrap: balance;
  }

  #opener-btn {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(245,239,230,0.55);
    background: transparent;
    color: #F5EFE6;
    padding: 15px 34px;
    border-radius: 999px;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 12px;
    opacity: 0;
    transform: translateY(20px);
    animation: op-in 1s 1.4s ease-out forwards;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .opener-btn-label { position: relative; z-index: 2; }
  .opener-btn-fill {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #4A0E19, #8B2E3A 55%, #6B1E2A);
    transform: translateY(101%);
    transition: transform 0.55s cubic-bezier(0.76, 0, 0.24, 1);
    z-index: 1;
  }
  #opener-btn:hover .opener-btn-fill,
  #opener-btn:focus-visible .opener-btn-fill { transform: translateY(0); }
  #opener-btn:hover, #opener-btn:focus-visible {
    border-color: transparent;
    outline: none;
  }
  #opener-btn[data-anim="counting"] {
    pointer-events: none;
    opacity: 0 !important;
    transform: translateY(-10px);
    transition: all 0.4s ease;
  }

  #opener-countdown {
    margin-top: 8px;
    height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease, height 0.5s ease;
    overflow: visible;
  }
  #opener[data-state="counting"] #opener-countdown {
    opacity: 1;
    height: 130px;
  }
  #opener[data-state="counting"] #opener-btn { display: none; }

  .opener-ring-wrap {
    position: relative;
    width: 110px; height: 110px;
    margin: 10px auto 0;
    display: grid; place-items: center;
  }
  .opener-ring {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    transform: rotate(-90deg);
    filter: drop-shadow(0 4px 20px rgba(107,30,42,0.5));
  }
  .opener-ring-track {
    fill: none; stroke: rgba(245,239,230,0.15); stroke-width: 2.5;
  }
  #opener-ring-progress {
    fill: none;
    stroke: url(#ring-grad);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 339.29;
    stroke-dashoffset: 339.29;
    transition: stroke-dashoffset 1s linear;
  }
  #opener-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.25rem;
    line-height: 1;
    color: #F5EFE6;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 16px rgba(0,0,0,0.4);
  }

  html.opening, html.opening body { overflow: clip; }

  @media (prefers-reduced-motion: reduce) {
    #opener-bg { animation: none; transform: none; }
    #opener-inner *, #opener-inner { animation: none !important; opacity: 1 !important; transform: none !important; }
  }

  @keyframes op-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
</style>

<script>
  import { gsap } from "gsap";

  const KEY = "rp-opener-shown";
  const opener = document.getElementById("opener");
  const btn = document.getElementById("opener-btn");
  const num = document.getElementById("opener-num");
  const ring = document.getElementById("opener-ring-progress") as SVGCircleElement | null;
  const path = document.getElementById("op-path") as SVGPathElement | null;

  // Personalize guest name from ?to= URL param (Astro static build cannot
  // read query params at build time, so we hydrate here).
  const guestEl = document.getElementById("opener-guest");
  if (guestEl) {
    try {
      const raw = new URLSearchParams(window.location.search).get("to");
      if (raw) {
        const clean = raw.trim().slice(0, 120);
        if (clean) guestEl.textContent = clean;
      }
    } catch {}
  }

  const alreadyShown = sessionStorage.getItem(KEY) === "1";

  if (!opener || !btn || !num || !ring || !path || alreadyShown) {
    opener?.remove();
    document.documentElement.classList.remove("opening");
  } else {
    document.documentElement.classList.add("opening");

    const CIRC = 339.29;
    const DURATION = 10;

    btn.addEventListener("click", startCountdown, { once: true });

    function startCountdown() {
      opener!.dataset.state = "counting";
      btn!.setAttribute("data-anim", "counting");

      let remaining = DURATION;
      num!.textContent = String(remaining);

      ring!.style.strokeDashoffset = "0";
      requestAnimationFrame(() => {
        ring!.style.transitionDuration = `${DURATION}s`;
        ring!.style.strokeDashoffset = String(CIRC);
      });

      const tick = setInterval(() => {
        remaining -= 1;
        if (remaining <= 0) {
          num!.textContent = "0";
          clearInterval(tick);
          setTimeout(reveal, 300);
          return;
        }
        num!.textContent = String(remaining);
      }, 1000);
    }

    function reveal() {
      const upHalf = "M0,500  Q500,300  1000,500  L1000,1100 L0,1100 Z";
      const cover  = "M0,-100 Q500,-100 1000,-100 L1000,1100 L0,1100 Z";
      const drain  = "M0,-100 Q500,-100 1000,-100 L1000,-100 L0,-100 Z";

      const tl = gsap.timeline({
        onComplete: () => {
          sessionStorage.setItem(KEY, "1");
          opener!.remove();
          document.documentElement.classList.remove("opening");
          document.dispatchEvent(new CustomEvent("opener:done"));
        },
      });

      tl.to("#opener-inner > *", {
        opacity: 0, y: -12, duration: 0.4, ease: "power2.in", stagger: 0.05,
      })
        .to(path, { attr: { d: upHalf }, duration: 0.5, ease: "power2.in" }, "-=0.3")
        .to(path, { attr: { d: cover },  duration: 0.45, ease: "power2.out" })
        .to({}, { duration: 0.35 })
        .to(path, { attr: { d: drain },  duration: 0.95, ease: "expo.inOut" });
    }
  }
</script>
