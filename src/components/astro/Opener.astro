---
// Opener — full-screen silhouette background with 10s countdown.
// Auto-reveals invitation after countdown; skip button available.
// Shown once per session.
import { getLocale, t } from "@/i18n";
const locale = getLocale(Astro.url);
const openLabel = locale === "id" ? "Buka Undangan" : "Open Invitation";
const openingIn = locale === "id" ? "Undangan akan terbuka dalam" : "Invitation opens in";
const skipLabel = locale === "id" ? "Lewati" : "Skip";
---

<div id="opener" aria-hidden="false">
  <!-- Silhouette background -->
  <div id="opener-bg"></div>
  <div id="opener-vignette"></div>

  <!-- Burgundy satin exit curtain (SVG path morph) -->
  <svg id="opener-curtain" viewBox="0 0 1000 1000" preserveAspectRatio="none">
    <defs>
      <linearGradient id="op-satin" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4A0E19" />
        <stop offset="50%" stop-color="#8B2E3A" />
        <stop offset="100%" stop-color="#2A0810" />
      </linearGradient>
    </defs>
    <path id="op-path" d="M0,1100 Q500,1100 1000,1100 L1000,1100 L0,1100 Z" fill="url(#op-satin)" />
  </svg>

  <!-- Foreground content -->
  <div id="opener-inner">
    <img id="opener-logo" src="/logo/monogram-white.png" alt="" />

    <div id="opener-hero">
      <p class="eyebrow text-cream/70">{t(locale, "hero.eyebrow")}</p>
      <h1 id="opener-title">Rahma <span class="accent-italic text-burgundy-rose">&amp;</span> Prima</h1>
      <p id="opener-date" class="eyebrow text-cream/60">{t(locale, "hero.date")}</p>
    </div>

    <div id="opener-countdown">
      <p class="eyebrow text-cream/60 mb-3">{openingIn}</p>
      <div class="opener-ring-wrap">
        <svg class="opener-ring" viewBox="0 0 100 100">
          <circle class="opener-ring-track" cx="50" cy="50" r="46" />
          <circle id="opener-ring-progress" cx="50" cy="50" r="46" />
        </svg>
        <span id="opener-num">10</span>
      </div>
      <button id="opener-skip" type="button">{skipLabel} <span aria-hidden="true">→</span></button>
    </div>
  </div>
</div>

<style>
  #opener {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    color: #F5EFE6;
  }
  #opener-bg {
    position: absolute; inset: 0;
    background-image: url("/photos/opener-bg.jpg");
    background-size: cover;
    background-position: center;
    background-color: #0A0A0A;
    transform: scale(1.05);
    animation: op-zoom 12s ease-out forwards;
  }
  @keyframes op-zoom {
    to { transform: scale(1); }
  }
  #opener-vignette {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 50%, transparent 30%, rgba(0,0,0,0.55) 75%, rgba(0,0,0,0.85) 100%),
      linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, transparent 25%, transparent 65%, rgba(0,0,0,0.7) 100%);
  }
  #opener-curtain {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    display: block;
  }

  #opener-inner {
    position: relative;
    z-index: 2;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: center;
    justify-items: center;
    padding: clamp(24px, 6vw, 48px) var(--page-pad);
    text-align: center;
  }
  #opener-logo {
    width: clamp(48px, 9vw, 72px);
    height: auto;
    opacity: 0;
    transform: translateY(-8px);
    animation: op-fade-down 1s 0.2s var(--ease-out-expo, ease-out) forwards;
  }
  @keyframes op-fade-down { to { opacity: 0.9; transform: none; } }

  #opener-hero { display: flex; flex-direction: column; gap: 18px; align-items: center; }
  #opener-hero .eyebrow { opacity: 0; animation: op-in 0.9s 0.4s var(--ease-out-expo, ease-out) forwards; }
  #opener-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3.5rem, 15vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: 0;
    opacity: 0;
    animation: op-in 1.2s 0.6s var(--ease-out-expo, ease-out) forwards;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
  }
  #opener-date { opacity: 0; animation: op-in 0.9s 1s var(--ease-out-expo, ease-out) forwards; }
  @keyframes op-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

  #opener-countdown {
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    opacity: 0;
    animation: op-in 1s 1.3s var(--ease-out-expo, ease-out) forwards;
  }
  .opener-ring-wrap {
    position: relative;
    width: 92px; height: 92px;
    display: grid; place-items: center;
  }
  .opener-ring {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    transform: rotate(-90deg);
  }
  .opener-ring-track {
    fill: none; stroke: rgba(245,239,230,0.15); stroke-width: 2;
  }
  #opener-ring-progress {
    fill: none;
    stroke: #B85450;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 289.03;   /* 2*pi*46 */
    stroke-dashoffset: 289.03;
    transition: stroke-dashoffset 1s linear;
  }
  #opener-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2rem;
    line-height: 1;
    color: #F5EFE6;
    font-variant-numeric: tabular-nums;
  }
  #opener-skip {
    background: none;
    border: 1px solid rgba(245,239,230,0.3);
    color: rgba(245,239,230,0.75);
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex; align-items: center; gap: 8px;
  }
  #opener-skip:hover, #opener-skip:focus-visible {
    background: #F5EFE6; color: #0A0A0A; outline: none;
  }

  html.opening, html.opening body { overflow: clip; }

  @media (prefers-reduced-motion: reduce) {
    #opener-bg { animation: none; transform: none; }
    #opener-inner *, #opener-inner { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  import { gsap } from "gsap";

  const KEY = "rp-opener-shown";
  const opener = document.getElementById("opener");
  const num = document.getElementById("opener-num");
  const ring = document.getElementById("opener-ring-progress") as SVGCircleElement | null;
  const skip = document.getElementById("opener-skip");
  const path = document.getElementById("op-path") as SVGPathElement | null;

  const alreadyShown = sessionStorage.getItem(KEY) === "1";
  const prefersReduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!opener || !num || !ring || !skip || !path || alreadyShown) {
    opener?.remove();
    document.documentElement.classList.remove("opening");
  } else {
    document.documentElement.classList.add("opening");

    const DURATION = prefersReduce ? 2 : 10;
    let remaining = DURATION;
    const CIRC = 289.03;

    // initial ring: full at start
    ring.style.strokeDashoffset = "0";
    // animate depletion
    setTimeout(() => {
      ring.style.transitionDuration = `${DURATION}s`;
      ring.style.strokeDashoffset = String(CIRC);
    }, 50);

    num.textContent = String(DURATION);
    const tick = setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        num.textContent = "0";
        clearInterval(tick);
        openInvitation();
        return;
      }
      num.textContent = String(remaining);
    }, 1000);

    skip.addEventListener("click", () => {
      clearInterval(tick);
      openInvitation();
    });

    function openInvitation() {
      // curtain morph: flat bottom → sweep up to cover → drain up (bloop)
      const upHalf = "M0,500  Q500,300  1000,500  L1000,1100 L0,1100 Z";
      const cover  = "M0,-100 Q500,-100 1000,-100 L1000,1100 L0,1100 Z";
      const drain  = "M0,-100 Q500,-100 1000,-100 L1000,-100 L0,-100 Z";

      const tl = gsap.timeline({
        onComplete: () => {
          sessionStorage.setItem(KEY, "1");
          opener!.remove();
          document.documentElement.classList.remove("opening");
          document.dispatchEvent(new CustomEvent("opener:done"));
        },
      });

      tl.to("#opener-inner > *", {
        opacity: 0, y: -12, duration: 0.5, ease: "power2.in", stagger: 0.04,
      })
        .to(path, { attr: { d: upHalf }, duration: 0.45, ease: "power2.in" }, "-=0.3")
        .to(path, { attr: { d: cover }, duration: 0.4, ease: "power2.out" })
        .to(path, { attr: { d: drain }, duration: 0.85, ease: "expo.inOut" }, "+=0.15");
    }
  }
</script>
