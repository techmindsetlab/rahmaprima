---
// Opener flow:
//   1. Silhouette bg + Bismillah Arabic + names + "Open Invitation" button
//   2. Click → 10s countdown ring (gradient black→burgundy)
//   3. Countdown done → satin burgundy curtain reveals invitation
import { getLocale, t } from "@/i18n";
const locale = getLocale(Astro.url);
const openLabel = locale === "id" ? "Buka Undangan" : "Open Invitation";
const bismillah = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";
---

<div id="opener" aria-hidden="false" data-state="idle">
  <div id="opener-bg"></div>
  <div id="opener-vignette"></div>

  <!-- Burgundy satin exit curtain -->
  <svg id="opener-curtain" viewBox="0 0 1000 1000" preserveAspectRatio="none">
    <defs>
      <linearGradient id="op-satin" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4A0E19" />
        <stop offset="40%" stop-color="#8B2E3A" />
        <stop offset="70%" stop-color="#6B1E2A" />
        <stop offset="100%" stop-color="#2A0810" />
      </linearGradient>
    </defs>
    <path id="op-path" d="M0,1100 Q500,1100 1000,1100 L1000,1100 L0,1100 Z" fill="url(#op-satin)" />
  </svg>

  <div id="opener-inner">
    <img id="opener-logo" src="/logo/monogram-white.png" alt="" />

    <div id="opener-hero">
      <p lang="ar" dir="rtl" id="opener-bismillah" class="font-quran">{bismillah}</p>
      <p class="eyebrow text-cream/75">{t(locale, "hero.eyebrow")}</p>
      <h1 id="opener-title">Rahma <span class="accent-italic text-burgundy-rose">&amp;</span> Prima</h1>
      <p id="opener-date" class="eyebrow text-cream/70">{t(locale, "hero.date")}</p>
    </div>

    <!-- Button (idle state) -->
    <button id="opener-btn" type="button" data-anim="idle">
      <span class="opener-btn-fill" aria-hidden="true"></span>
      <span class="opener-btn-label">{openLabel}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Countdown ring (hidden until click) -->
    <div id="opener-countdown" aria-hidden="true">
      <div class="opener-ring-wrap">
        <svg class="opener-ring" viewBox="0 0 120 120">
          <defs>
            <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0A0A0A" />
              <stop offset="50%" stop-color="#4A0E19" />
              <stop offset="100%" stop-color="#B85450" />
            </linearGradient>
          </defs>
          <circle class="opener-ring-track" cx="60" cy="60" r="54" />
          <circle id="opener-ring-progress" cx="60" cy="60" r="54" />
        </svg>
        <span id="opener-num">10</span>
      </div>
    </div>
  </div>
</div>

<style>
  #opener {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    color: #F5EFE6;
  }
  #opener-bg {
    position: absolute; inset: 0;
    background-image: url("/photos/opener-bg.webp");
    background-size: cover;
    background-position: center;
    background-color: #0A0A0A;
    transform: scale(1.06);
    animation: op-zoom 14s ease-out forwards;
  }
  @keyframes op-zoom { to { transform: scale(1); } }

  #opener-vignette {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 50%, transparent 30%, rgba(0,0,0,0.55) 75%, rgba(0,0,0,0.9) 100%),
      linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, transparent 25%, transparent 60%, rgba(0,0,0,0.75) 100%);
  }
  #opener-curtain {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    display: block;
    z-index: 3;
  }

  #opener-inner {
    position: relative;
    z-index: 2;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: center;
    justify-items: center;
    padding: clamp(24px, 6vw, 48px) var(--page-pad);
    text-align: center;
  }

  #opener-logo {
    width: clamp(52px, 10vw, 80px);
    height: auto;
    opacity: 0;
    transform: translateY(-8px);
    animation: op-fade-down 1s 0.2s ease-out forwards;
  }
  @keyframes op-fade-down { to { opacity: 0.92; transform: none; } }

  #opener-hero {
    display: flex; flex-direction: column; gap: 16px; align-items: center;
  }
  #opener-bismillah {
    font-size: clamp(1.25rem, 5vw, 2.25rem);
    color: #F5EFE6;
    opacity: 0;
    animation: op-in 1.1s 0.4s ease-out forwards;
    text-shadow: 0 2px 24px rgba(0,0,0,0.5);
    margin: 0 0 12px;
  }
  #opener-hero .eyebrow { opacity: 0; animation: op-in 0.9s 0.7s ease-out forwards; }
  #opener-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3.2rem, 14vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: 0;
    opacity: 0;
    animation: op-in 1.2s 0.9s ease-out forwards;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.5);
  }
  #opener-date { opacity: 0; animation: op-in 0.9s 1.2s ease-out forwards; }
  @keyframes op-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

  /* Button */
  #opener-btn {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(245,239,230,0.5);
    background: transparent;
    color: #F5EFE6;
    padding: 16px 32px;
    border-radius: 999px;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 12px;
    opacity: 0;
    transform: translateY(20px);
    animation: op-in 1s 1.5s ease-out forwards;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .opener-btn-label, #opener-btn svg { position: relative; z-index: 2; }
  .opener-btn-fill {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #4A0E19, #8B2E3A, #6B1E2A);
    transform: translateY(101%);
    transition: transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
    z-index: 1;
  }
  #opener-btn:hover .opener-btn-fill,
  #opener-btn:focus-visible .opener-btn-fill { transform: translateY(0); }
  #opener-btn:hover, #opener-btn:focus-visible {
    border-color: transparent;
    outline: none;
  }
  #opener-btn[data-anim="counting"] {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.4s ease;
  }

  /* Countdown ring */
  #opener-countdown {
    position: absolute;
    left: 50%; bottom: clamp(60px, 12vh, 120px);
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  #opener[data-state="counting"] #opener-countdown { opacity: 1; }
  #opener[data-state="counting"] #opener-btn { display: none; }

  .opener-ring-wrap {
    position: relative;
    width: 110px; height: 110px;
    display: grid; place-items: center;
  }
  .opener-ring {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    transform: rotate(-90deg);
    filter: drop-shadow(0 4px 20px rgba(107,30,42,0.4));
  }
  .opener-ring-track {
    fill: none; stroke: rgba(245,239,230,0.15); stroke-width: 2.5;
  }
  #opener-ring-progress {
    fill: none;
    stroke: url(#ring-grad);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 339.29;   /* 2π·54 */
    stroke-dashoffset: 339.29;
    transition: stroke-dashoffset 1s linear;
  }
  #opener-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.25rem;
    line-height: 1;
    color: #F5EFE6;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 16px rgba(0,0,0,0.4);
  }

  html.opening, html.opening body { overflow: clip; }

  @media (prefers-reduced-motion: reduce) {
    #opener-bg { animation: none; transform: none; }
    #opener-inner *, #opener-inner { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  import { gsap } from "gsap";

  const KEY = "rp-opener-shown";
  const opener = document.getElementById("opener");
  const btn = document.getElementById("opener-btn");
  const num = document.getElementById("opener-num");
  const ring = document.getElementById("opener-ring-progress") as SVGCircleElement | null;
  const path = document.getElementById("op-path") as SVGPathElement | null;

  const alreadyShown = sessionStorage.getItem(KEY) === "1";

  if (!opener || !btn || !num || !ring || !path || alreadyShown) {
    opener?.remove();
    document.documentElement.classList.remove("opening");
  } else {
    document.documentElement.classList.add("opening");

    const CIRC = 339.29;
    const DURATION = 10;

    btn.addEventListener("click", startCountdown, { once: true });

    function startCountdown() {
      opener!.dataset.state = "counting";
      btn!.setAttribute("data-anim", "counting");

      let remaining = DURATION;
      num!.textContent = String(remaining);

      // Ring gradient depletion
      ring!.style.strokeDashoffset = "0";
      requestAnimationFrame(() => {
        ring!.style.transitionDuration = `${DURATION}s`;
        ring!.style.strokeDashoffset = String(CIRC);
      });

      const tick = setInterval(() => {
        remaining -= 1;
        if (remaining <= 0) {
          num!.textContent = "0";
          clearInterval(tick);
          setTimeout(reveal, 300);
          return;
        }
        num!.textContent = String(remaining);
      }, 1000);
    }

    function reveal() {
      const upHalf = "M0,500  Q500,300  1000,500  L1000,1100 L0,1100 Z";
      const cover  = "M0,-100 Q500,-100 1000,-100 L1000,1100 L0,1100 Z";
      const drain  = "M0,-100 Q500,-100 1000,-100 L1000,-100 L0,-100 Z";

      const tl = gsap.timeline({
        onComplete: () => {
          sessionStorage.setItem(KEY, "1");
          opener!.remove();
          document.documentElement.classList.remove("opening");
          document.dispatchEvent(new CustomEvent("opener:done"));
        },
      });

      tl.to("#opener-inner > *", {
        opacity: 0, y: -12, duration: 0.4, ease: "power2.in", stagger: 0.03,
      })
        .to(path, { attr: { d: upHalf }, duration: 0.5, ease: "power2.in" }, "-=0.3")
        .to(path, { attr: { d: cover },  duration: 0.45, ease: "power2.out" })
        .to({}, { duration: 0.35 })
        .to(path, { attr: { d: drain },  duration: 0.95, ease: "expo.inOut" });
    }
  }
</script>
