---
import { getLocale, t } from "@/i18n";
const locale = getLocale(Astro.url);
---

<section class="relative bg-ink text-cream/90 py-28 md:py-40">
  <div class="container-fluid max-w-3xl mx-auto text-center">
    <img src="/logo/monogram-white-sm.png" alt="" class="mx-auto h-14 md:h-20 opacity-90 mb-10" data-reveal />

    <p
      lang="ar"
      dir="rtl"
      class="font-quran text-cream text-2xl md:text-4xl leading-[2.4] mb-10"
      data-reveal
      data-reveal-delay="0.1"
    >
      {t(locale, "quote.arabic")}
    </p>

    <div class="mx-auto w-16 h-px bg-cream/25 my-8"></div>

    <p class="font-serif italic text-lg md:text-2xl leading-relaxed text-cream/85 max-w-2xl mx-auto" data-reveal data-reveal-delay="0.2">
      {t(locale, "quote.verse")}
    </p>
    <p class="eyebrow mt-6 text-burgundy-rose" data-reveal data-reveal-delay="0.3">
      {t(locale, "quote.source")}
    </p>
  </div>
</section>
